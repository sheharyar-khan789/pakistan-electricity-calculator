# Copy to .env.local for local overrides. All values are PUBLIC (NEXT_PUBLIC_*):
# they are inlined into the build. Never put secrets here.
# Full launch steps: docs/SEO-LAUNCH.md

# Canonical origin of the production site: https, no path, no trailing slash.
# Every canonical, Open Graph URL, sitemap entry, robots.txt sitemap line and
# structured-data URL is built from this. Unset = http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Search-engine indexing. Only the exact value "true" enables it, and the build
# FAILS if it is "true" while NEXT_PUBLIC_SITE_URL is missing, http, localhost
# or a *.vercel.app address. Vercel preview deployments are never indexed.
# Set "true" ONLY on the production deployment.
NEXT_PUBLIC_ENABLE_INDEXING=

# Google Search Console "HTML tag" verification. Paste ONLY the content value
# from <meta name="google-site-verification" content="THIS_VALUE" />.
# Leave empty if you verify with a DNS TXT record instead.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Public contact address shown on /contact. Leave empty until a real inbox exists.
NEXT_PUBLIC_CONTACT_EMAIL=
